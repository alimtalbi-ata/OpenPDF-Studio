  "risks": [
    "Inheritance chain across many release-specific GUI modules",
    "No real Windows GUI end-to-end verification in this environment",
    "Portable onefile startup may be slower due to extraction",
    "Text-only editable exports cannot guarantee original layout fidelity",
    "Windows antivirus may flag unsigned executables",
    "Portable EXE and installer are build recipes, not compiled Windows binaries in this ZIP"
  ],
  "recommendations": [
    "Replace historical GUI inheritance with a stable application shell and independent feature controllers",
    "Centralize commands in a typed operation registry",
    "Separate UI from PDF service layer and use dependency injection for testability",
    "Add Windows VM CI with real launch, UI automation, file round-trips, installer uninstall",
    "Publish SHA-256 and code-signing when available"
  ]
}